---
import { slugify } from '@/utils/content'
import { FolderOpen, Tags } from 'lucide-astro'

interface Props {
  tags: string[]
  category?: string
  class?: string
}

const { tags, category, class: className } = Astro.props
---

<div
  class="flex flex-wrap gap-2 text-sm text-neutral-500 dark:text-neutral-400"
  class:list={[className]}
>
  {
    category && (
      <div>
        <FolderOpen size={14} class="inline-block -translate-y-0.5" />
        <a
          class="hover:text-teal-600 dark:text-teal-400 hover:underline underline-offset-2 decoration-dashed"
          href={`/categories/${slugify(category)}`}
        >
          {category}
        </a>
      </div>
    )
  }
  {
    tags.length > 0 && (
      <div>
        <Tags size={14} class="inline-block -translate-y-0.5" />
        {tags.map((tag, index) => (
          <>
            {index > 0 && <span>, </span>}
            <a
              class="hover:text-teal-600 dark:text-teal-400 hover:underline underline-offset-2 decoration-dashed"
              href={`/tags/${slugify(tag)}`}
            >
              {tag}
            </a>
          </>
        ))}
      </div>
    )
  }
</div>
