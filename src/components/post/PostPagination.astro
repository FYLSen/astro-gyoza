---
import { Ellipsis, ChevronLeft, ChevronRight } from 'lucide-astro'

interface Props {
  current: number
  total: number
  getPageUrl: (page: number) => string
}

const { current, total, getPageUrl } = Astro.props

interface PaginationItem {
  type: 'page' | 'ellipsis' | 'nav'
  page?: number
  icon?: 'ChevronLeft' | 'ChevronRight'
  label?: string
}

function generatePaginationItems(current: number, total: number): PaginationItem[] {
  if (total <= 1) return []
  if (current < 1) current = 1
  if (current > total) current = total

  const items: PaginationItem[] = []

  if (current > 1) {
    items.push({
      type: 'nav',
      page: current - 1,
      icon: 'ChevronLeft',
      label: '上一页',
    })
  }

  const visiblePages = new Set<number>()

  visiblePages.add(1)
  visiblePages.add(total)
  visiblePages.add(current)
  if (current - 1 > 1) visiblePages.add(current - 1)
  if (current + 1 < total) visiblePages.add(current + 1)

  const sortedPages = Array.from(visiblePages).sort((a, b) => a - b)

  sortedPages.forEach((page, index) => {
    if (index > 0 && page - sortedPages[index - 1] > 1) {
      items.push({ type: 'ellipsis' })
    }
    items.push({ type: 'page', page })
  })

  if (current < total) {
    items.push({
      type: 'nav',
      page: current + 1,
      icon: 'ChevronRight',
      label: '下一页',
    })
  }

  return items
}

const paginationItems = generatePaginationItems(current, total)

const baseButtonStyles =
  'size-8 rounded-lg flex items-center justify-center transition-bg-color duration-200 select-none'
const hoverStyles = 'hover:bg-accent/20'
const currentPageStyles = 'text-white bg-accent dark:text-black'
---

<div class="mt-12 flex items-center justify-center gap-2">
  {
    paginationItems.map((item) => {
      if (item.type === 'nav') {
        return (
          <a
            class={`${baseButtonStyles} ${hoverStyles}`}
            href={getPageUrl(item.page!)}
            aria-label={item.label}
          >
            {item.icon === 'ChevronLeft' ? <ChevronLeft size={16} /> : <ChevronRight size={16} />}
          </a>
        )
      }

      if (item.type === 'ellipsis') {
        return (
          <span class={`${baseButtonStyles} cursor-default`}>
            <Ellipsis size={16} />
          </span>
        )
      }

      return (
        <a
          href={item.page === current ? undefined : getPageUrl(item.page!)}
          class={`${baseButtonStyles} ${
            item.page === current
              ? `${currentPageStyles} cursor-default`
              : `${hoverStyles} cursor-pointer`
          }`}
        >
          {item.page}
        </a>
      )
    })
  }
</div>
