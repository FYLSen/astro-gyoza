---
import { getFormattedShortDate } from '@/utils/date'
import { Calendar, NotepadText, AlarmClock } from 'lucide-astro'

interface Props {
  date: Date
  lastMod?: Date
  words: number
  readingMinutes: number
  class?: string
}

const { date, lastMod, words, readingMinutes, class: className } = Astro.props
---

<div
  class="flex flex-wrap gap-2 text-sm text-neutral-500 dark:text-neutral-400"
  class:list={[className]}
>
  <div>
    <Calendar size={13} class="inline-block -translate-y-0.5" />
    <span>{getFormattedShortDate(date)}</span>
    {lastMod && <span class="text-xs">(已编辑)</span>}
  </div>
  <div>
    <NotepadText size={13} class="inline-block -translate-y-0.5" />
    <span>{words} 字</span>
  </div>
  <div>
    <AlarmClock size={13} class="inline-block -translate-y-0.5" />
    <span>{Math.ceil(readingMinutes)} 分钟</span>
  </div>
</div>
