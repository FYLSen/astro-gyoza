---
import type { CollectionEntry } from 'astro:content'
import { PostCardHoverOverlay } from './PostCardHoverOverlay'
import PostMetaInfo from './PostMetaInfo.astro'
import { Lock, Pin } from 'lucide-astro'

interface Props {
  entry: CollectionEntry<'posts'>
}

const { entry } = Astro.props

const { remarkPluginFrontmatter } = await entry.render()
---

<a class="block relative py-8 focus-visible:outline-0 group" href={`/posts/${entry.slug}/`}>
  <PostCardHoverOverlay client:only="react" />
  <h2 class="relative text-2xl font-bold">
    <span>{entry.data.title}</span>
    <div
      class="absolute top-0 right-0 z-10 flex items-center gap-2 text-teal-600 dark:text-teal-400"
    >
      {entry.data.password && <Lock size={16} />}
      {entry.data.sticky > 0 && <Pin size={16} class="transform rotate-45" />}
    </div>
  </h2>
  <div class="mt-4 overflow-hidden">
    {
      entry.data.cover && (
        <div class="float-right ml-3 mb-2 w-full md:w-auto overflow-hidden rounded-md">
          <div
            class="relative w-full md:w-[160px] h-[180px] md:h-[120px]"
            style="aspect-ratio: 4/3;"
          >
            <img
              class="w-full h-full object-cover select-none transition-transform duration-300 ease-in-out group-hover:scale-110"
              src={entry.data.cover}
              alt={entry.data.title}
              loading="lazy"
            />
          </div>
        </div>
      )
    }
    {entry.data.summary && <p>{entry.data.summary}</p>}
  </div>
  <div class="mt-2 flex flex-wrap items-center justify-end gap-4 select-none">
    <PostMetaInfo
      class="grow"
      date={entry.data.date}
      lastMod={entry.data.lastMod}
      words={remarkPluginFrontmatter.words}
      readingMinutes={remarkPluginFrontmatter.readingMinutes}
    />
    <div class="group/arrow shrink-0 text-teal-600 dark:text-teal-400 flex items-center gap-2">
      <span>继续阅读</span>
      <svg width="36" height="12" viewBox="0 0 36 12" fill="none" class="stroke-current">
        <path
          d="M0.75 6H11.25 M6 0.75L11.25 6L6 11.25"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M15 10L19.5 5.5L15 1"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="delay-100 opacity-0 group-hover/arrow:opacity-100"></path>
        <path
          d="M23 10L27.5 5.5L23 1"
          stroke-opacity="0.66"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="delay-200 opacity-0 group-hover/arrow:opacity-100"></path>
        <path
          d="M31 10L35.5 5.5L31 1"
          stroke-opacity="0.35"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="delay-300 opacity-0 group-hover/arrow:opacity-100"></path>
      </svg>
    </div>
  </div>
</a>
