---
import type { CollectionEntry } from 'astro:content'
import { getShortDate } from '@/utils/date'
import TimelineComponent from '@/components/Timeline'

interface Props {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props

// 确保分组数据符合 Timeline 组件的类型要求
type GroupedPosts = {
  year: number
  months: Set<number>
  posts: {
    slug: string
    title: string
    date: string
    month: number
    password?: boolean
    sticky?: number
  }[]
}[]

const groupedPosts = posts.reduce<GroupedPosts>((acc, cur) => {
  const year = cur.data.date.getFullYear()
  const month = cur.data.date.getMonth()
  const lastYearGroup = acc[acc.length - 1]
  if (lastYearGroup && lastYearGroup.year === year) {
    lastYearGroup.months.add(month)
    lastYearGroup.posts.push({
      slug: cur.slug,
      title: cur.data.title,
      date: getShortDate(cur.data.date),
      month,
      password: !!cur.data.password,
      sticky: cur.data.sticky || undefined,
    })
  } else {
    acc.push({
      year,
      months: new Set([month]),
      posts: [
        {
          slug: cur.slug,
          title: cur.data.title,
          date: getShortDate(cur.data.date),
          month,
          password: !!cur.data.password,
          sticky: cur.data.sticky || undefined,
        },
      ],
    })
  }
  return acc
}, [])

// 将 Set 转换为数组以便传递给组件，并按月份倒序排序
const processedGroupedPosts = groupedPosts.map((group) => ({
  ...group,
  months: Array.from(group.months).sort((a, b) => b - a),
}))
---

<TimelineComponent client:load groupedPosts={processedGroupedPosts} />
