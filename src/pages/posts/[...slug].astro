---
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import MarkdownLayout from '@/layouts/MarkdownLayout.astro'
import { getSortedPosts } from '@/utils/content'
import MarkdownWrapper from '@/components/MarkdownWrapper.astro'
import SectionBlock from '@/components/SectionBlock.astro'
import { PostToc } from '@/components/post/PostToc'
import PostMetaInfo from '@/components/post/PostMetaInfo.astro'
import PostArchiveInfo from '@/components/post/PostArchiveInfo.astro'
import { ReadingProgress } from '@/components/post/ReadingProgress'
import { Outdate } from '@/components/post/Outdate'
import PostNav from '@/components/post/PostNav.astro'
import { Comments } from '@/components/comment'
import { PostCopyright } from '@/components/post/PostCopyright'
import { AISummaryStream } from '@/components/post/AISummaryStream'
import { site, author, AIConfig } from '@/config.json'
import { ContentDecryption } from '@/components/post/ContentDecryption'

export const getStaticPaths = (async () => {
  const sortedPosts = await getSortedPosts()

  return sortedPosts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      current: post,
      prev: index > 0 ? sortedPosts[index - 1] : undefined,
      next: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : undefined,
    },
  }))
}) satisfies GetStaticPaths

interface Props {
  current: CollectionEntry<'posts'>
  prev?: CollectionEntry<'posts'>
  next?: CollectionEntry<'posts'>
}

const { current, prev, next } = Astro.props

const { headings, Content, remarkPluginFrontmatter } = await current.render()

const mdSlug = `/posts/${current.slug}`

const mdDescription = concat(current.data.category || '', current.data.tags.join(', '))

function concat(str1: string, str2: string, sep = ' / ') {
  if (str1 && str2) return str1 + sep + str2
  if (str1) return str1
  if (str2) return str2
  return ''
}

const lastMod = current.data.lastMod || current.data.date
const fullUrl = new URL(mdSlug, Astro.site).toString()

const isPasswordProtected = !!current.data.password

const authorSocialLinks = Object.values(author.social ?? {}).filter(Boolean)

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: current.data.title,
  ...(current.data.cover && { image: [current.data.cover] }),
  datePublished: current.data.date,
  dateModified: current.data.lastMod,
  license: current.data.license,
  author: [
    {
      '@type': 'Person',
      name: author.name,
      url: site.url,
      ...(authorSocialLinks.length > 0 && { sameAs: authorSocialLinks }),
    },
  ],
  publisher: [
    {
      '@type': 'Organization',
      name: site.title,
      url: site.url,
    },
  ],
}
---

<MarkdownLayout
  title={current.data.title}
  description={current.data.summary}
  image={current.data.cover}
  mdTitle={current.data.title}
  mdDescription={mdDescription}
  mdSlug={mdSlug}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="max-w-[1100px] mx-auto px-4 md:px-8 py-16 grid lg:grid-cols-[auto_260px] gap-8">
    <div>
      <header class="space-y-4">
        <h1 class="text-4xl font-bold text-center">
          {current.data.title}
        </h1>
        <PostMetaInfo
          class="justify-center"
          date={current.data.date}
          lastMod={current.data.lastMod}
          words={remarkPluginFrontmatter.words}
          readingMinutes={remarkPluginFrontmatter.readingMinutes}
        />
        <PostArchiveInfo
          class="justify-center"
          category={current.data.category}
          tags={current.data.tags}
        />
        <div>
          <Outdate lastMod={lastMod} client:idle />
        </div>
      </header>
    </div>
    <div class="col-start-1 min-w-0">
      {AIConfig.enable && current.data.aisummary && <AISummaryStream url={fullUrl} client:load />}
      {
        isPasswordProtected ? (
          <div class="relative">
            <ContentDecryption
              onUnlock={() => {
                const tocContent = document.querySelector('[data-toc-content]')
                if (tocContent) {
                  tocContent.classList.remove('hidden')
                }
                document.dispatchEvent(new CustomEvent('content-unlocked'))
              }}
              client:load
            />
            <div id="protected-content" class="hidden">
              <Content />
            </div>
            <MarkdownWrapper />
          </div>
        ) : (
          <MarkdownWrapper>
            <Content />
          </MarkdownWrapper>
        )
      }
    </div>
    <div class="hidden lg:block">
      <aside class="sticky top-20">
        <SectionBlock title="目录">
          <div class:list={['toc-wrapper', { hidden: isPasswordProtected }]} data-toc-content>
            <PostToc headings={headings} client:idle />
            <hr class="my-2 border-neutral-200 dark:border-neutral-700 max-w-[100px]" />
            <ReadingProgress client:idle />
          </div>
        </SectionBlock>
      </aside>
    </div>
    <div>
      <section class="space-y-6">
        <PostCopyright
          title={current.data.title}
          slug={mdSlug}
          lastMod={lastMod}
          license={current.data.license}
          client:visible
        />
        <PostNav prev={prev} next={next} />
        {current.data.comments && <Comments />}
      </section>
    </div>
  </div>
</MarkdownLayout>

<script>
  // 处理密码保护的客户端逻辑
  document.addEventListener('DOMContentLoaded', () => {
    const protectedContent = document.getElementById('protected-content')
    const tocContent = document.querySelector('[data-toc-content]')

    if (protectedContent && tocContent) {
      document.addEventListener('content-unlocked', () => {
        protectedContent.classList.remove('hidden')
        tocContent.classList.remove('hidden')
      })
    }
  })
</script>
