---
import { hero } from '@/config.json'
import Layout from '@/layouts/Layout.astro'
import MoonPhase from '@/components/MoonPhase'
import { getCurrentMoonPhase } from '@/utils/moonPhase'
import { ArrowUpLeft } from 'lucide-astro'
import { TypewriterText } from '@/components/TypewriterText'

const currentPhase = getCurrentMoonPhase()
---

<Layout title="404">
  <div class="flex items-center justify-center min-h-screen">
    <div class="container mx-auto px-8">
      <div
        class="lg:flex lg:items-center lg:justify-center lg:gap-12 lg:divide-x lg:divide-primary/20"
      >
        <div class="text-center lg:w-1/3 lg:pr-12">
          <MoonPhase client:load phaseConfig={currentPhase} />
        </div>

        <div class="text-center lg:text-left lg:w-2/3 lg:pl-12">
          <h1
            class="m-0 text-[10rem] leading-tight font-thin bg-gradient-to-r from-accent
                     bg-clip-text text-transparent animate-hue
                     drop-shadow-[0_0_30px_rgba(254,171,58,0.3)]
                     md:text-[10rem] sm:text-[4rem]"
          >
            404
          </h1>

          <div class="max-w-xl">
            <p
              class="text-xl leading-normal text-primary
                     drop-shadow-[0_0_10px_rgba(255,255,255,0.2)]
                     md:text-lg sm:text-base"
            >
              <TypewriterText text={hero.yiyan} speed={40} delay={0.1} client:load />
            </p>

            <a
              href="/"
              class="mt-20 inline-flex items-center whitespace-nowrap cursor-pointer tracking-wider text-sm
                      border-2 border-primary leading-9 h-9 px-4
                      text-primary transition-all duration-300 ease-in-out backdrop-blur-sm
                      hover:bg-primary hover:text-root hover:-translate-y-0.5
                      hover:shadow-[0_5px_15px_rgba(255,255,255,0.1)]
                      rounded-full
                      md:text-sm md:leading-9 md:h-9
                      sm:text-xs sm:leading-7 sm:h-7 sm:rounded-[14px]"
            >
              <ArrowUpLeft size={14} class="inline-block mr-1" />
              返回首页
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
