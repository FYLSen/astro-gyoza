---
import { hero } from '@/config.json'
import Layout from '@/layouts/Layout.astro'
import MoonPhase from '@/components/MoonPhase'
import { ArrowUpLeft } from 'lucide-astro'
import SplashCursor from '@/components/SplashCursor'
import { FadeContent } from '@/components/FadeContent'
---

<Layout title="404">
  <SplashCursor client:only="react" />
  <div class="flex items-center justify-center min-h-screen dark:bg-neutral-700">
    <div class="container mx-auto px-8">
      <div
        class="lg:flex lg:items-center lg:justify-center lg:gap-12 lg:divide-x lg:divide-neutral-400/20"
      >
        <div class="text-center lg:w-1/3 lg:pr-12">
          <MoonPhase client:only="react" />
        </div>

        <div class="text-center lg:text-left lg:w-2/3 lg:pl-12">
          <h1
            class="m-0 text-[10rem] leading-tight font-thin bg-gradient-to-r from-accent
                     bg-clip-text text-transparent animate-hue
                     drop-shadow-[0_0_30px_rgba(254,171,58,0.3)]
                     md:text-[10rem] sm:text-[4rem]"
          >
            404
          </h1>

          <div class="max-w-xl lg:mx-0 mx-auto">
            <FadeContent
              blur={true}
              duration={1800}
              easing="ease-out"
              delay={300}
              threshold={0.3}
              initialOpacity={0.3}
              className="text-l text-neutral-500 dark:text-neutral-400 mt-3 text-center lg:text-left drop-shadow-[0_0_10px_rgba(255,255,255,0.2)] break-words"
              client:only="react">{hero.yiyan}</FadeContent
            >

            <div class="flex justify-center lg:justify-start">
              <button
                onclick="window.location.href='/'"
                class="mt-20 inline-flex items-center whitespace-nowrap cursor-pointer tracking-wider text-sm rounded-full border-2 border-neutral-100 leading-9 h-9 px-4 text-neutral-900 dark:text-neutral-100 transition-all duration-300 ease-in-out backdrop-blur-sm hover:bg-white dark:bg-neutral-900 hover:text-bg-root hover:-translate-y-0.5 hover:shadow-[0_5px_15px_rgba(255,255,255,0.1)] md:text-sm md:leading-9 md:h-9 sm:text-xs sm:leading-7 sm:h-7 active:bg-neutral-600/50 active:text-bg-root"
              >
                <ArrowUpLeft size={14} class="inline-block mr-1" />
                返回首页
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
